{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "idle-game",
  "compatibility_date": "2026-05-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.js",
  "observability": { "enabled": true },
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  }
}
